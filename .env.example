# Optional override for the native test gauge DLL path.
# If you don't set this, the app will try these defaults:
# - src-tauri/bin/wasm_test.dll (when run from repo root)
# - bin/wasm_test.dll (when run from src-tauri)
#
# Note: nvg_shim.dll must sit next to wasm_test.dll.
IWE_TEST_WASM_DLL_PATH=src-tauri/bin/wasm_test.dll
